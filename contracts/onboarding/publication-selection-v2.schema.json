{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-intelligence.local/contracts/onboarding/publication-selection-v2.schema.json",
  "title": "retail-publication-selection/v2",
  "description": "Immutable full-scope lifecycle evidence selecting one verified source publication or result bundle. Identity is derived with the declared ordered RFC 6901 exclusion vector; no latest or capability-only lookup is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectionId",
    "semanticIdentityExcludes",
    "scope",
    "subject",
    "readiness",
    "lifecycle",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "retail-publication-selection/v2"
    },
    "selectionId": {
      "type": "string",
      "pattern": "^sel_[0-9a-f]{16}$"
    },
    "semanticIdentityExcludes": {
      "const": [
        "/approval",
        "/lifecycle",
        "/selectionId",
        "/semanticIdentityExcludes"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "subject": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourcePublication"
        },
        {
          "$ref": "#/$defs/resultBundle"
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportFingerprint",
        "capabilityReadiness",
        "capabilitySufficiency",
        "claimAuthorization"
      ],
      "properties": {
        "reportFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "capabilityReadiness": {
          "enum": [
            "ready",
            "validated_partial",
            "unavailable",
            "blocked"
          ]
        },
        "capabilitySufficiency": {
          "enum": [
            "sufficient",
            "insufficient_evidence",
            "not_evaluated"
          ]
        },
        "claimAuthorization": {
          "enum": [
            "authorized",
            "descriptive_only",
            "not_authorized"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supersedes",
        "recordId"
      ],
      "properties": {
        "state": {
          "enum": [
            "candidate",
            "approved",
            "active",
            "superseded",
            "rejected"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^rec_[0-9a-f]{16}$"
        },
        "recordId": {
          "type": "string",
          "pattern": "^rec_[0-9a-f]{16}$"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "recordedAt",
        "reason",
        "evidenceFingerprint"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceFingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailerId",
        "tenantId",
        "capability",
        "environment"
      ],
      "properties": {
        "retailerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "capability": {
          "enum": [
            "current_descriptive_analytics",
            "demand_forecast_non_pit",
            "historical_replay",
            "point_in_time_forecasting",
            "inventory_replenishment_current_snapshot",
            "inventory_replenishment_replay",
            "price_revenue",
            "price_margin",
            "price_simulation",
            "competitor_intelligence",
            "promotion_planning",
            "promotion_response",
            "promotion_aware_forecasting",
            "competitor_aware_forecasting"
          ]
        },
        "environment": {
          "enum": [
            "local",
            "dev",
            "staging",
            "prod"
          ]
        }
      }
    },
    "sourcePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceSnapshotId",
        "gateASemanticFingerprint",
        "gateBSemanticFingerprint",
        "publicationSemanticFingerprint",
        "manifestSha256",
        "logicalPath",
        "objectCount",
        "duckdbSha256"
      ],
      "properties": {
        "kind": {
          "const": "source_publication"
        },
        "sourceSnapshotId": {
          "$ref": "#/$defs/sha256"
        },
        "gateASemanticFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "gateBSemanticFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "publicationSemanticFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "logicalPath": {
          "type": "string",
          "minLength": 1
        },
        "objectCount": {
          "type": "integer",
          "minimum": 1
        },
        "duckdbSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resultBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bundleId",
        "bundleSemanticFingerprint",
        "manifestSha256",
        "logicalPath",
        "artifactCount"
      ],
      "properties": {
        "kind": {
          "const": "result_bundle"
        },
        "bundleId": {
          "type": "string",
          "pattern": "^bundle_[0-9a-f]{16}$"
        },
        "bundleSemanticFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "logicalPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
