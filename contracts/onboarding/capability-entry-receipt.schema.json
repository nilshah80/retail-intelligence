{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-intelligence.local/contracts/onboarding/capability-entry-receipt.schema.json",
  "title": "Capability entry-record adoption receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "executedAt", "orderedRecords", "pointerBefore", "pointerAfter", "outcome", "failure", "recovery"],
  "properties": {
    "schemaVersion": {"const": "retail-capability-entry-receipt/v1"},
    "receiptId": {"$ref": "#/$defs/uuidv7"},
    "executedAt": {"type": "string", "format": "date-time"},
    "orderedRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "recordId", "recordByteSha256"],
        "properties": {
          "scope": {"$ref": "#/$defs/scope"},
          "recordId": {"$ref": "#/$defs/sha256"},
          "recordByteSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "pointerBefore": {"$ref": "#/$defs/pointerIdentity"},
    "pointerAfter": {"$ref": "#/$defs/pointerIdentity"},
    "outcome": {"enum": ["adopted", "refused"]},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasonCode", "failingScope", "detail"],
          "properties": {
            "reasonCode": {"enum": ["INVALID_ENTRY", "PREDECESSOR_MISMATCH", "CREATE_ONLY_COLLISION", "LOCK_UNAVAILABLE", "RECOVERY_CONFLICT", "INTERRUPTED_BEFORE_ADOPTION"]},
            "failingScope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scope"}]},
            "detail": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovered", "journalId"],
      "properties": {
        "recovered": {"type": "boolean"},
        "journalId": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retailerId", "tenantId", "capability", "environment"],
      "properties": {
        "retailerId": {"type": "string", "minLength": 1},
        "tenantId": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "pointerIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {"state": {"const": "absent"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "byteSha256"],
          "properties": {
            "state": {"const": "present"},
            "byteSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
