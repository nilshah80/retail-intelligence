{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-intelligence.local/contracts/onboarding/capability-entry-pointer.schema.json",
  "title": "Capability entry-record adoption pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastAdoptionReceiptId", "entries"],
  "properties": {
    "schemaVersion": {"const": "retail-capability-entry-pointer/v1"},
    "lastAdoptionReceiptId": {"$ref": "#/$defs/uuidv7"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "recordId", "recordPath", "recordByteSha256", "adoptionReceiptId"],
        "properties": {
          "scope": {"$ref": "#/$defs/scope"},
          "recordId": {"$ref": "#/$defs/sha256"},
          "recordPath": {"type": "string", "pattern": "^contracts/evidence/capability-entry-records/capability-entry-record-[a-f0-9]{64}\\.json$"},
          "recordByteSha256": {"$ref": "#/$defs/sha256"},
          "adoptionReceiptId": {"$ref": "#/$defs/uuidv7"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uuidv7": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retailerId", "tenantId", "capability", "environment"],
      "properties": {
        "retailerId": {"type": "string", "minLength": 1},
        "tenantId": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    }
  }
}
