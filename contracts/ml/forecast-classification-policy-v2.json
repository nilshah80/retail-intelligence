  "exceptions": {
    "classes": {
      "cold_start_interval_unavailable": {
        "consumerBehavior": {
          "coerceNullToZero": false,
          "note": "P50 remains available and usable where the consuming feature's own contract authorizes it. An interval-dependent output is skipped, never computed from a zero spread: safety stock is quantile spread times service level, so a zero would return zero safety stock on the least predictable products.",
          "retainCentralForecast": true
        },
        "emitOnce": "Exactly one record per affected SeriesKey. forecast_exceptions is keyed on (version_id, sku_id, store_id, channel_id, exception_class) and has no horizon column, so per-horizon records would collide rather than accumulate. The affected horizon range is carried in the evidence.",
        "formula": "interval_available=false for at least one selected horizon of the SeriesKey; affected range is [unavailableFromHorizon, unavailableThroughHorizon]",
        "grain": "series_key",
        "severity": "medium",
        "thresholds": {
          "calibratedMaxHorizon": 4,
          "reasonCode": "COLD_START_INTERVAL_UNCALIBRATED"
        },
        "trigger": "cohort=cold_start AND any horizon > calibratedMaxHorizon carries interval_available=false"
      },
      "data_quality_exception": {
        "formula": "data_quality_class=Issue",
        "severity": "high",
        "thresholds": {},
        "trigger": "formula is true"
      },
      "high_over_forecast_risk": {
        "formula": "over_gap_units=yhat_p50-ma13_baseline; over_gap_ratio=over_gap_units/max(ma13_baseline,1)",
        "severity": "high",
        "thresholds": {
          "minimumGapRatio": "0.50",
          "minimumGapUnits": "5"
        },
        "trigger": "over_gap_units>=5 AND over_gap_ratio>=0.50"
      },
      "high_under_forecast_risk": {
        "formula": "upper_gap_units=yhat_p90-yhat_p50; upper_gap_ratio=upper_gap_units/max(yhat_p50,1)",
        "severity": "high",
        "thresholds": {
          "minimumGapRatio": "0.50",
          "minimumGapUnits": "5"
        },
        "trigger": "upper_gap_units>=5 AND upper_gap_ratio>=0.50"
      },
      "new_product_sparse_history": {
        "formula": "history_weeks<26 OR zero_share_52w>0.60",
        "severity": {
          "high": "history_weeks<13 OR zero_share_52w>0.80",
          "medium": "otherwise"
        },
        "thresholds": {
          "highZeroShare": "0.80",
          "minimumEstablishedHistoryWeeks": 26,
          "minimumHistoryWeeks": 13,
          "sparseZeroShare": "0.60"
        },
        "trigger": "formula is true"
      },
      "promotion_uplift_conflict": {
        "formula": "uplift_shortfall=planned_promotion_uplift_pct-forecast_uplift_vs_ma13_pct",
        "severity": "medium",
        "thresholds": {
          "minimumPlannedUpliftPct": "0.10",
          "minimumUpliftShortfallPct": "0.10"
        },
        "trigger": "promotion_plan_available AND planned_promotion_uplift_pct>=0.10 AND uplift_shortfall>=0.10",
        "unavailableBehavior": {
          "emitException": false,
          "reasonCode": "NO_ORIGIN_VISIBLE_PROMOTION_PLAN",
          "renderingState": "unavailable"
        }
      }
    },
