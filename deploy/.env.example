# Local Docker Desktop defaults only. Copy to deploy/.env to override.
# Never reuse these credentials outside a developer workstation.
RETAIL_POSTGRES_USER=retail
RETAIL_POSTGRES_PASSWORD=retail-local-only
RETAIL_POSTGRES_DB=retail_intelligence
RETAIL_POSTGRES_PORT=5432

MLFLOW_PORT=5000
MLFLOW_WORKERS=2
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
